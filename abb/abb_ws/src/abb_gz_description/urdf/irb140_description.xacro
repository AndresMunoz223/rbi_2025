<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="abb_robot">

  <!-- Materials for visualization -->
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  
  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>

  <!-- Base link (world reference) -->
  <link name="world_0"/>

  <!-- ABB Base Link -->
  <link name="abb_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.6 0.1"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.6 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1000"/>
      <inertia ixx="5.05" ixy="0.0" ixz="0.0" iyy="5.05" iyz="0.0" izz="10.0"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world_0"/>
    <child link="abb_base"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- First Joint Body -->
  <link name="first_joint_body">
    <visual>
      <origin xyz="0 0 -0.245" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.08"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="-0.245 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.6 0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <visual>
      <origin xyz="0 0.25 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.1 0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.245" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="0.08"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.245 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.6 0.2"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0.25 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.1 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.8"/>
    </inertial>
  </link>

  <joint name="position_joint_0" type="revolute">
    <parent link="abb_base"/>
    <child link="first_joint_body"/>
    <origin xyz="0 0 0.342" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="1000" velocity="2.0"/>
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <!-- Second Joint Body -->
  <link name="second_joint_body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.4"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0.2 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.2 0.1"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.4"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.2 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.2 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.2 0 0.25" rpy="0 0 0"/>
      <mass value="8"/>
      <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.4"/>
    </inertial>
  </link>

  <joint name="position_joint_1" type="revolute">
    <parent link="first_joint_body"/>
    <child link="second_joint_body"/>
    <origin xyz="0.06988 0 0" rpy="1.5708 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="1000" velocity="2.0"/>
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <!-- Third Joint Body -->
  <link name="third_joint_body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.4"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.4"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.15" ixy="0.0" ixz="0.0" iyy="0.15" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="position_joint_2" type="revolute">
    <parent link="second_joint_body"/>
    <child link="third_joint_body"/>
    <origin xyz="0.362 0 0" rpy="0 0 3.14159"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="1000" velocity="2.0"/>
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <!-- Fourth Joint Body -->
  <link name="fourth_joint_body">
    <visual>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.2"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <mass value="3"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="position_joint_3" type="revolute">
    <parent link="third_joint_body"/>
    <child link="fourth_joint_body"/>
    <origin xyz="0 0.380 0" rpy="-1.5708 0 3.14159"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="1000" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- Fifth Joint Body -->
  <link name="fifth_joint_body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.2"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="position_joint_4" type="revolute">
    <parent link="fourth_joint_body"/>
    <child link="fifth_joint_body"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 3.14159"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="1000" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- Sixth Joint Body (End Effector) -->
  <link name="sixth_joint_body">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.1"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="position_joint_5" type="revolute">
    <parent link="fifth_joint_body"/>
    <child link="sixth_joint_body"/>
    <origin xyz="0 0.25 0" rpy="-1.5708 0 3.14159"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="1000" velocity="2.0"/>
    <dynamics damping="0.3" friction="0.0"/>
  </joint>

  <!-- End Effector Link (for TCP) -->
  <link name="tool">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="sixth_joint_body"/>
    <child link="tool"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo-specific tags -->
  <gazebo reference="abb_base">
    <material>Gazebo/Red</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>0</self_collide>
  </gazebo>

  <gazebo reference="first_joint_body">
    <material>Gazebo/Blue</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <gazebo reference="second_joint_body">
    <material>Gazebo/Blue</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <gazebo reference="third_joint_body">
    <material>Gazebo/Blue</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <gazebo reference="fourth_joint_body">
    <material>Gazebo/Blue</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <gazebo reference="fifth_joint_body">
    <material>Gazebo/Blue</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <gazebo reference="sixth_joint_body">
    <material>Gazebo/Blue</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>



</robot>