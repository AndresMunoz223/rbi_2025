<launch>
    <let name="urdf_path" 
         value="$(find-pkg-share abb_mujoco_description)/urdf/abb_description.urdf.xacro" />
    <let name="rviz_config_path"
         value="$(find-pkg-share abb_mujoco_bringup)/config/rviz_config.rviz" />

    <node pkg="controller_manager" exec="ros2_control_node">
        <param from="$(find-pkg-share abb_mujoco_bringup)/config/abb_controllers.yaml"/>
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <node pkg="controller_manager" exec="spawner" args="abb_controller"/>

    <node pkg="abb_tf_generator" exec="abb_tf_generator"/>

    <node pkg="abb_ik_solver" exec="abb_ik_solver"/>

    <node pkg="abb_path_generator" exec="abb_path_generator"/>

    <node pkg="abb_path_controller" exec="abb_path_controller"/>

    <node pkg="rviz2" exec="rviz2" output="screen" 
          args="-d $(var rviz_config_path)" />

</launch>